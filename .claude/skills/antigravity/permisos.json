{
  "permissions": {
    "allow": [
      "read_file(*)",
      "command(ls)",
      "command(ls *)",
      "command(find *)",
      "command(grep *)",
      "command(rg *)",
      "command(cat *)",
      "command(head *)",
      "command(tail *)",
      "command(wc *)",
      "command(git status*)",
      "command(git diff*)",
      "command(git log*)",
      "command(git show*)",
      "command(./gradlew *)"
    ],
    "deny": [
      "command(git push*)",
      "command(git commit*)",
      "command(git reset*)",
      "command(git checkout*)",
      "command(rm *)",
      "command(curl *)",
      "command(wget *)"
    ]
  }
}
